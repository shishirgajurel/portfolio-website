@page "/Error"
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["NoIndex"] = true;
}
<main id="main">
    <section class="section wrap article">
        <h1 class="h1-small">@Model.Heading</h1>
        <p class="lead">@Model.Message</p>
        <div class="cta"><a class="btn primary" href="/">Back to the homepage</a></div>
    </section>
</main>
