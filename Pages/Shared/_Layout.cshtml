@inject AppDbContext Db
@inject IConfiguration Config
@{
    var site = await Db.Settings.AsNoTracking().FirstAsync();
    var req = Context.Request;
    var baseUrl = SiteUrl.BaseUrl(req, Config);
    var title = ViewData["Title"] as string ?? site.FullName;
    var desc = ViewData["Description"] as string ?? site.Intro;
    var canonical = baseUrl + req.Path;
    var image = ViewData["Image"] as string ?? site.PhotoPath;
    var noIndex = ViewData["NoIndex"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@title</title>
    <meta name="description" content="@desc">
    @if (noIndex)
    {
        <meta name="robots" content="noindex, nofollow">
    }
    else
    {
        <link rel="canonical" href="@canonical">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="@site.FullName">
        <meta property="og:title" content="@title">
        <meta property="og:description" content="@desc">
        <meta property="og:url" content="@canonical">
        <meta name="twitter:card" content="@(string.IsNullOrEmpty(image) ? "summary" : "summary_large_image")">
        <meta name="twitter:title" content="@title">
        <meta name="twitter:description" content="@desc">
        @if (!string.IsNullOrEmpty(image))
        {
            <meta property="og:image" content="@(baseUrl + image)">
            <meta name="twitter:image" content="@(baseUrl + image)">
        }
    }
    <meta name="theme-color" content="#0f172a">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%234f46e5'/%3E%3Ctext x='50' y='66' font-size='46' font-family='sans-serif' font-weight='700' fill='white' text-anchor='middle'%3ESG%3C/text%3E%3C/svg%3E">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="nav">
    <div class="wrap">
        <a class="logo" href="/">shishir<span>.dev</span></a>
        <nav aria-label="Primary">
            <ul>
                <li><a href="/#about">About</a></li>
                <li><a href="/#projects">Projects</a></li>
                <li><a href="/#contact">Contact</a></li>
            </ul>
        </nav>
        <button class="toggle" id="theme" type="button" aria-label="Toggle light and dark theme">◐</button>
    </div>
</header>

@RenderBody()

<footer>
    <div class="wrap">© @DateTime.UtcNow.Year @site.FullName@(string.IsNullOrEmpty(site.Address) ? "" : " · " + site.Address)</div>
</footer>
</body>
</html>
